# Base de données (docker compose up -d db). En production : URL avec pooling.
DATABASE_URI=postgres://saloum:saloum@localhost:5432/saloum_evasion

# Payload (≥ 32 caractères aléatoires)
PAYLOAD_SECRET=

# Origine absolue du site (canonical, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protège la route de revalidation appelée par les hooks Payload
REVALIDATE_SECRET=

# Mux (vidéo HLS)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Resend (notification des demandes)
RESEND_API_KEY=
REQUEST_FROM_EMAIL=

# Sel du hachage d'IP pour la limitation de débit
RATE_LIMIT_SALT=

# Plausible (vide = mesure désactivée en local)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Stockage S3-compatible des médias (facultatif en local : disque)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Compte administrateur créé par le seed de démonstration (développement et tests seulement)
SEED_ADMIN_EMAIL=admin@saloum-evasion.test
SEED_ADMIN_PASSWORD=

# Secret des tâches planifiées (purge quotidienne : /api/cron/purge)
CRON_SECRET=

# Tests : boîte d’envoi des e-mails (au lieu de Resend) et limite de demandes par heure
EMAIL_OUTBOX_DIR=
REQUEST_RATE_LIMIT=

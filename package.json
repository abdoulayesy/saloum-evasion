{
  "name": "saloum-evasion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test --project=android-360 --project=android-360-landscape --project=iphone-se --project=pixel-7 --project=desktop --project=desktop-admin",
    "e2e:nojs": "playwright test --project=nojs",
    "lhci": "lhci autorun",
    "bundles": "node --experimental-strip-types --no-warnings scripts/check-bundles.ts",
    "seo:check": "node --experimental-strip-types --no-warnings scripts/seo-check.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate && pnpm cache:clear",
    "migrate:create": "payload migrate:create",
    "seed": "payload run src/seed/index.ts && pnpm cache:clear",
    "seed:checkout": "payload run scripts/seed-checkout.ts && pnpm cache:clear",
    "seed:guides": "payload run scripts/seed-guides.ts && pnpm cache:clear",
    "cms:experiences-hub": "payload run scripts/sync-experiences-hub.ts && pnpm cache:clear",
    "cms:privacy-register": "payload run scripts/sync-privacy-register.ts && pnpm cache:clear",
    "cache:clear": "node --experimental-strip-types --no-warnings scripts/clear-data-cache.ts",
    "e2e:checkout": "playwright test --grep @checkout",
    "jobs:dev": "node --env-file=.env --experimental-strip-types --no-warnings scripts/jobs-dev.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@react-pdf/renderer": "^4.9.0",
    "graphql": "^16.8.1",
    "hls.js": "1.5.20",
    "next": "^15.4.11",
    "next-intl": "^4",
    "payload": "3.93.0",
    "react": "19",
    "react-dom": "19",
    "resend": "6",
    "schema-dts": "^1",
    "sharp": "^0.34.5",
    "web-vitals": "5",
    "zod": "4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "3",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "9",
    "eslint-config-next": "^15.4.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "linkinator": "^6.3.0",
    "postcss": "^8.5.33",
    "prettier": "3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "16",
    "tailwindcss": "4",
    "typescript": "5",
    "vitest": "3"
  },
  "pnpm": {
    "overrides": {
      "@tailwindcss/node>magic-string": "0.30.21"
    }
  }
}
